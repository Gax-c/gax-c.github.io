{% comment %}
  Homepage "highlights" section. Items come from _data/highlights.yml.
{% endcomment %}
<div class="highlights">
  {% for item in site.data.highlights %}
    <div class="highlight-card">
      {% if item.tags %}
        <div class="highlight-tags">
          {% for tag in item.tags %}
            <span class="highlight-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <h3 class="highlight-title">
        {% if item.url %}
          <a href="{{ item.url }}">{{ item.title }}</a>
        {% else %}
          {{ item.title }}
        {% endif %}
      </h3>

      {% if item.description %}
        <div class="highlight-desc">{{ item.description | markdownify }}</div>
      {% endif %}

      {% if item.embed %}
        {% include highlights/{{ item.embed }} %}
      {% endif %}

      {% if item.links %}
        <div class="highlight-actions">
          {% for link in item.links %}
            <a class="highlight-btn{% if link.primary %} highlight-btn-primary{% endif %}" href="{{ link.url }}">
              {%- if link.icon %}<i class="{{ link.icon }}"></i> {% endif -%}
              {{ link.name }}
              {%- if link.primary %} <i class="fa-solid fa-arrow-right"></i>{% endif -%}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
